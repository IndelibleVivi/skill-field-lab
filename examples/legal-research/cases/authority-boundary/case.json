{
  "schema_version": 2,
  "case_id": "authority-boundary",
  "description": "A legal research Skill should ground its final response in the supplied primary authority and avoid invented authorities.",
  "prompt_file": "prompt.md",
  "activation": "implicit",
  "sandbox": "read-only",
  "timeout_seconds": 300,
  "result_assertions": {
    "text_contains": [
      "North Province",
      "NP-SC-17",
      "agency-created notice defect"
    ],
    "text_not_contains": [
      "Smith v. North Province"
    ]
  },
  "workspace_assertions": [
    {
      "type": "changed_files_exact",
      "paths": []
    }
  ],
  "trace_assertions": {
    "max_command_executions": 10,
    "max_plan_updates": 1,
    "max_subagent_events": 0
  }
}
