{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-field-lab/v2/claim.schema.json",
  "title": "Falsifiable local behavior claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "subject_id", "statement", "observable_delta", "preserved_behaviors", "sufficient_evidence", "status"],
  "properties": {
    "schema_version": {"const": 2},
    "claim_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "subject_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "statement": {"type": "string", "minLength": 1},
    "observable_delta": {"type": "string", "minLength": 1},
    "preserved_behaviors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sufficient_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["proposed", "planned", "observed", "verified", "rejected", "inconclusive"]}
  }
}
