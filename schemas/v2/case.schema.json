{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-field-lab/v2/case.schema.json",
  "title": "Skill Field Lab v2 behavior case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "description", "prompt_file", "activation", "sandbox", "timeout_seconds"],
  "anyOf": [
    {"required": ["result_assertions"]},
    {"required": ["workspace_assertions"]},
    {"required": ["command_assertions"]},
    {"required": ["trace_assertions"]},
    {"required": ["human_review_requirements"]}
  ],
  "properties": {
    "schema_version": {"const": 2},
    "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "description": {"type": "string", "minLength": 1},
    "prompt_file": {"type": "string", "pattern": "^[^/\\\\]+$"},
    "activation": {"enum": ["implicit", "explicit", "direct"]},
    "sandbox": {"enum": ["read-only", "workspace-write"]},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "result_assertions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text_contains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "text_not_contains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "text_matches": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "json_schema": {"type": "object"}
      }
    },
    "workspace_assertions": {"type": "array", "items": {"$ref": "#/$defs/workspace_assertion"}},
    "command_assertions": {"type": "array", "items": {"$ref": "#/$defs/command_assertion"}},
    "trace_assertions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_command_executions": {"type": "integer", "minimum": 0},
        "max_plan_updates": {"type": "integer", "minimum": 0},
        "max_subagent_events": {"type": "integer", "minimum": 0},
        "reference_reads_include": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "human_review_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "human_review_material": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "workspace_assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "value"],
          "properties": {
            "type": {"enum": ["file_equals", "file_contains", "file_not_contains"]},
            "path": {"type": "string", "minLength": 1},
            "value": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": {"const": "file_exists"},
            "path": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "paths"],
          "properties": {
            "type": {"const": "changed_files_exact"},
            "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          }
        }
      ]
    },
    "command_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exit_code": {"type": "integer", "default": 0},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    }
  }
}
