{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-field-lab/v2/receipt.schema.json",
  "title": "Content-light Field Lab v2 evidence receipt",
  "type": "object",
  "required": ["schema_version", "receipt_type", "created_at", "lab_id", "claim_ids", "subject_id", "evidence", "outcome", "artifacts"],
  "properties": {
    "schema_version": {"const": 2},
    "receipt_type": {"enum": ["attempt", "observed"]},
    "created_at": {"type": "string"},
    "run_id": {"type": "string"},
    "attempt_id": {"type": "string"},
    "lab_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "subject_id": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object",
      "required": ["origin", "subject_scope", "comparison", "verification_methods", "independence", "comparison_capable"],
      "properties": {
        "origin": {"enum": ["observed", "synthetic"]},
        "subject_scope": {"enum": ["isolated-control", "workspace-scoped", "hermetic"]},
        "comparison": {"enum": ["unmatched", "single", "matched"]},
        "verification_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["deterministic", "human", "llm"]}},
        "independence": {"enum": ["implementer-run", "separate-agent", "external-reviewer"]},
        "comparison_capable": {"type": "boolean"},
        "exclusive_subject_claimed": {"type": "boolean"}
      }
    },
    "claim_assessment": {"enum": ["supported", "not-supported", "inconclusive"]},
    "outcome": {"enum": ["pass", "fail", "error", "timeout", "termination-failure", "inconclusive", "input-drift", "preflight-failed"]},
    "subject_delivery": {
      "type": "object",
      "description": "Per-attempt materialized-mount evidence; absent on legacy receipts means unknown.",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["verified", "failed", "unknown"]},
        "mount": {"type": ["string", "null"]},
        "source_type": {"enum": ["control", "local-path", "snapshot", "local-git-ref"]},
        "expected_tree_sha256": {"type": ["string", "null"]},
        "actual_tree_sha256": {"type": ["string", "null"]},
        "requested_ref": {"type": ["string", "null"]},
        "resolved_commit": {"type": ["string", "null"]}
      }
    },
    "declared_activation": {"type": ["string", "null"], "enum": ["implicit", "explicit", "direct", null]},
    "host_selection": {"type": "object", "properties": {"status": {"enum": ["unknown", "observed"]}}},
    "content_application": {"type": "object", "properties": {"status": {"const": "requires-semantic-review"}}},
    "target_agent_invocations": {"type": "integer", "enum": [0, 1]},
    "artifacts": {"type": "object"}
  }
}
