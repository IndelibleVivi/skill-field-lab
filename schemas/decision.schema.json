{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-field-lab/decision.schema.json",
  "title": "Skill evolution decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "candidate_id", "decision", "basis", "accepted_delta", "excluded_delta", "evidence_receipts", "reopen_condition"],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["ADOPT", "ADAPT", "REJECT", "DEFER", "ALREADY COVERED"]},
    "basis": {"type": "string", "minLength": 1},
    "accepted_delta": {"type": "string"},
    "excluded_delta": {"type": "string"},
    "evidence_receipts": {"type": "array", "items": {"type": "string"}},
    "reopen_condition": {"type": "string", "minLength": 1}
  }
}
