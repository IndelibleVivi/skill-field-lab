{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-field-lab/plan.schema.json",
  "title": "Immutable target-agent execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "pack_path",
    "pack_id",
    "mode",
    "comparison_capable",
    "subjects",
    "cases",
    "repeat",
    "target_invocations",
    "llm_grader_invocations",
    "matrix",
    "planned_inputs",
    "execution",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string"
    },
    "pack_path": {
      "type": "string",
      "minLength": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "canary",
        "matched",
        "environment-smoke"
      ]
    },
    "comparison_capable": {
      "type": "boolean"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "repeat": {
      "type": "integer",
      "minimum": 1
    },
    "target_invocations": {
      "type": "integer",
      "minimum": 1
    },
    "llm_grader_invocations": {
      "const": 0
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "execution": {
      "type": "object"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "planned_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_sha256",
        "fieldlab_source_sha256",
        "adapter_executable",
        "subjects",
        "cases"
      ],
      "properties": {
        "pack_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subjects": {
          "type": "object"
        },
        "cases": {
          "type": "object"
        },
        "adapter_executable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested",
            "resolved_path",
            "sha256"
          ],
          "properties": {
            "requested": {
              "type": "string",
              "minLength": 1
            },
            "resolved_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "fieldlab_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
